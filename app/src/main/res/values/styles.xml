<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Типографика -->
    <style name="TextAppearance.KLO.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/roboto_bold</item>
        <item name="android:fontFamily">@font/roboto_bold</item>
    </style>
    <style name="TextAppearance.KLO.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/roboto_medium</item>
        <item name="android:fontFamily">@font/roboto_medium</item>
    </style>
    <style name="TextAppearance.KLO.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/roboto_medium</item>
        <item name="android:fontFamily">@font/roboto_medium</item>
    </style>
    <style name="TextAppearance.KLO.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/roboto_regular</item>
        <item name="android:fontFamily">@font/roboto_regular</item>
    </style>
    <style name="TextAppearance.KLO.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/roboto_regular</item>
        <item name="android:fontFamily">@font/roboto_regular</item>
    </style>
    <style name="TextAppearance.KLO.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="fontFamily">@font/roboto_regular</item>
        <item name="android:fontFamily">@font/roboto_regular</item>
    </style>
    <style name="TextAppearance.KLO.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/roboto_medium</item>
        <item name="android:fontFamily">@font/roboto_medium</item>
    </style>

    <!-- Формы -->
    <style name="ShapeAppearance.KLO.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_m</item>
    </style>
    <style name="ShapeAppearance.KLO.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_l</item>
    </style>

    <!-- Виджеты -->
    <style name="Widget.KLO.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainer</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="shapeAppearance">@style/ShapeAppearance.KLO.Medium</item>
    </style>
    <style name="Widget.KLO.Card.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="shapeAppearance">@style/ShapeAppearance.KLO.Medium</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
    </style>
    <style name="Widget.KLO.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/corner_m</item>
        <item name="boxCornerRadiusTopEnd">@dimen/corner_m</item>
        <item name="boxCornerRadiusBottomStart">@dimen/corner_m</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/corner_m</item>
    </style>
    <style name="Widget.KLO.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.KLO.Medium</item>
    </style>
    <style name="Widget.KLO.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">52dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.KLO.Medium</item>
    </style>
    <style name="Widget.KLO.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">52dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.KLO.Medium</item>
    </style>
    <style name="Widget.KLO.FormatButton" parent="Widget.Material3.Button.IconButton">
        <item name="iconTint">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Текст-подписи разделов -->
    <style name="KLO.SectionLabel">
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:layout_marginTop">@dimen/spacing_l</item>
        <item name="android:layout_marginBottom">@dimen/spacing_s</item>
    </style>
</resources>
