<?xml version="1.0" encoding="utf-8"?>
<!-- Граф навигации главной активности -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_main"
    app:startDestination="@id/notesFragment">

    <!-- ===== Вкладки нижней навигации ===== -->
    <fragment
        android:id="@+id/notesFragment"
        android:name="com.example.klo_kursach.ui.notes.NotesFragment"
        android:label="@string/nav_notes"
        tools:layout="@layout/fragment_notes">
        <action
            android:id="@+id/action_notes_to_editor"
            app:destination="@id/noteEditorFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_notes_to_export"
            app:destination="@id/exportBottomSheet" />
    </fragment>

    <fragment
        android:id="@+id/subjectsFragment"
        android:name="com.example.klo_kursach.ui.subjects.SubjectsFragment"
        android:label="@string/nav_subjects"
        tools:layout="@layout/fragment_subjects">
        <action
            android:id="@+id/action_subjects_to_subjectNotes"
            app:destination="@id/subjectNotesFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <fragment
        android:id="@+id/searchFragment"
        android:name="com.example.klo_kursach.ui.search.SearchFragment"
        android:label="@string/nav_search"
        tools:layout="@layout/fragment_search">
        <action
            android:id="@+id/action_search_to_editor"
            app:destination="@id/noteEditorFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.klo_kursach.ui.profile.ProfileFragment"
        android:label="@string/nav_profile"
        tools:layout="@layout/fragment_profile">
        <action
            android:id="@+id/action_profile_to_settings"
            app:destination="@id/settingsFragment" />
    </fragment>

    <!-- ===== Вложенные экраны ===== -->
    <fragment
        android:id="@+id/subjectNotesFragment"
        android:name="com.example.klo_kursach.ui.subjects.SubjectNotesFragment"
        android:label="{subjectName}"
        tools:layout="@layout/fragment_subject_notes">
        <argument
            android:name="subjectId"
            app:argType="long" />
        <argument
            android:name="subjectName"
            app:argType="string" />
        <action
            android:id="@+id/action_subjectNotes_to_editor"
            app:destination="@id/noteEditorFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <fragment
        android:id="@+id/noteEditorFragment"
        android:name="com.example.klo_kursach.ui.editor.NoteEditorFragment"
        android:label="{title}"
        tools:layout="@layout/fragment_note_editor">
        <argument
            android:name="noteId"
            android:defaultValue="-1L"
            app:argType="long" />
        <argument
            android:name="subjectId"
            android:defaultValue="-1L"
            app:argType="long" />
        <argument
            android:name="title"
            android:defaultValue="@string/title_editor_new"
            app:argType="string" />
        <action
            android:id="@+id/action_editor_to_ocr"
            app:destination="@id/ocrFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_editor_to_summary"
            app:destination="@id/summaryFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_editor_to_export"
            app:destination="@id/exportBottomSheet" />
    </fragment>

    <fragment
        android:id="@+id/ocrFragment"
        android:name="com.example.klo_kursach.ui.ocr.OcrFragment"
        android:label="@string/title_ocr"
        tools:layout="@layout/fragment_ocr" />

    <fragment
        android:id="@+id/summaryFragment"
        android:name="com.example.klo_kursach.ui.summary.SummaryFragment"
        android:label="@string/title_summary"
        tools:layout="@layout/fragment_summary">
        <argument
            android:name="sourceText"
            android:defaultValue=""
            app:argType="string" />
    </fragment>

    <dialog
        android:id="@+id/exportBottomSheet"
        android:name="com.example.klo_kursach.ui.export.ExportBottomSheet"
        android:label="@string/title_export"
        tools:layout="@layout/bottom_sheet_export">
        <argument
            android:name="noteId"
            android:defaultValue="-1L"
            app:argType="long" />
    </dialog>

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.klo_kursach.ui.settings.SettingsFragment"
        android:label="@string/title_settings" />

    <fragment
        android:id="@+id/aboutFragment"
        android:name="com.example.klo_kursach.ui.about.AboutFragment"
        android:label="@string/title_about"
        tools:layout="@layout/fragment_about" />

    <!-- Глобальные переходы из меню панели инструментов -->
    <action
        android:id="@+id/action_global_settings"
        app:destination="@id/settingsFragment" />
    <action
        android:id="@+id/action_global_about"
        app:destination="@id/aboutFragment" />
</navigation>
