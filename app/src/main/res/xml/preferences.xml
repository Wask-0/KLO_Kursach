<?xml version="1.0" encoding="utf-8"?>
<!-- Экран настроек (PreferenceFragmentCompat) -->
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/pref_category_appearance">
        <ListPreference
            app:defaultValue="system"
            app:entries="@array/theme_entries"
            app:entryValues="@array/theme_values"
            app:icon="@drawable/ic_dark_mode"
            app:key="theme"
            app:title="@string/pref_theme"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:defaultValue="normal"
            app:entries="@array/font_size_entries"
            app:entryValues="@array/font_size_values"
            app:icon="@drawable/ic_format_heading"
            app:key="font_size"
            app:title="@string/pref_font_size"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_category_data">
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:icon="@drawable/ic_storage"
            app:key="offline_only"
            app:summary="@string/pref_offline_summary"
            app:title="@string/pref_offline" />
        <ListPreference
            app:defaultValue="pdf"
            app:entries="@array/export_entries"
            app:entryValues="@array/export_values"
            app:icon="@drawable/ic_export"
            app:key="export_format"
            app:title="@string/pref_export_format"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_category_ai">
        <ListPreference
            app:defaultValue="ru_en"
            app:entries="@array/ocr_language_entries"
            app:entryValues="@array/ocr_language_values"
            app:icon="@drawable/ic_ocr"
            app:key="ocr_language"
            app:title="@string/pref_ocr_language"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:defaultValue="medium"
            app:entries="@array/ai_length_entries"
            app:entryValues="@array/ai_length_values"
            app:icon="@drawable/ic_ai"
            app:key="ai_length"
            app:title="@string/pref_ai_length"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_category_about">
        <Preference
            app:icon="@drawable/ic_info"
            app:key="version"
            app:title="@string/pref_version" />
    </PreferenceCategory>
</PreferenceScreen>
