<?xml version="1.0" encoding="utf-8"?>
<!-- Пунктирная рамка-заглушка для выбранного изображения (OCR) -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/md_surface_container" />
    <stroke
        android:width="2dp"
        android:color="@color/md_outline"
        android:dashGap="6dp"
        android:dashWidth="10dp" />
    <corners android:radius="@dimen/corner_l" />
</shape>
